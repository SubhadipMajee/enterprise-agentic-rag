# Runtime
APP_ENV = production
ASSISTANT_NAME = Enterprise Assistant
ASSISTANT_SCOPE = your organization's approved documentation

# Groq Reasoning Engine (Llama 3.3)
GROQ_API_KEY =
GROQ_FALLBACK_API_KEY =

# Portkey LLM Gateway
PORTKEY_API_KEY =
GROQ_SLUG = rag
GROQ_SLUG_2 = brag

# Qdrant Vector DB
QDRANT_API_KEY =
QDRANT_CLUSTER_ENDPOINT =
QDRANT_COLLECTION = enterprise_rag

# Gemini Embeddings
GEMINI_API_KEY =

# Auth (required when APP_ENV=production)
API_KEY =
DEBUG_KEY =
APP_PASSWORD =

# Browser CORS — comma-separated UI origins only (Streamlit server-side calls do not need this)
CORS_ORIGINS =

# Limits
MAX_QUERY_LENGTH = 2000
RATE_LIMIT_REQUESTS = 30
RATE_LIMIT_WINDOW_SECONDS = 60

# Conversation memory + rate limiting backend
# Options: memory (dev only) | redis (recommended) | postgres
# Production MUST be redis or postgres — memory is rejected.
# Redis is also used by the rate limiter for cross-instance consistency.
#
# Local dev:    docker compose up -d redis  →  redis://localhost:6379/0
# Cloud (GCP):  Create a Memorystore for Redis instance and use the internal IP
CHECKPOINT_BACKEND = memory
REDIS_URL = redis://localhost:6379/0
DATABASE_URL =

# Observability — keep tracing off in production unless you have a DPA and redaction policy
LOGFIRE_TOKEN =
LANGSMITH_TRACING = false
LANGSMITH_ENDPOINT = https://api.smith.langchain.com
LANGSMITH_API_KEY =
LANGSMITH_PROJECT =
LOG_USER_CONTENT = false
SHOW_INTERNAL_DETAILS = false

# Streamlit UI → FastAPI
BACKEND_URL = http://localhost:8000

# Eval judge LLM (keep separate from main key)
JUDGE_GROQ =
